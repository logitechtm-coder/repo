{
  "manifest_version": 3,
  "name": "TNUE - vOffice Downloader",
  "version": "1.2.116",
  "version_name": "1.2.116",
  "description": "Tool hỗ trợ tải tài liệu office",
  "author": "thangtm@tnue.edu.vn",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "TNUE - vOffice Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://vanban.tnu.edu.vn/*",
    "*://*.tnu.edu.vn/*",
    "*://vpdt.vnptioffice.vn/*",
    "*://*.vnptioffice.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://vanban.tnu.edu.vn/*",
        "*://*.tnu.edu.vn/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://vanban.tnu.edu.vn/*",
        "*://*.tnu.edu.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://vpdt.vnptioffice.vn/*",
        "*://*.vnptioffice.vn/*"
      ],
      "js": [
        "vnpt_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://vpdt.vnptioffice.vn/*",
        "*://*.vnptioffice.vn/*"
      ],
      "js": [
        "vnpt_content.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "*://vanban.tnu.edu.vn/*",
        "*://*.tnu.edu.vn/*",
        "*://vpdt.vnptioffice.vn/*",
        "*://*.vnptioffice.vn/*"
      ]
    }
  ]
}